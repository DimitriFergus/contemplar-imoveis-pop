# Copie para .env.local e preencha. Nunca versione .env.local.

# URL pública do site, sem barra no final (usada em canonical, sitemap, Open Graph e JSON-LD).
NEXT_PUBLIC_SITE_URL=https://www.exemplo.com.br

# true = faixa "Site em demonstração" e selo "Imóvel ilustrativo" nos imóveis de exemplo.
NEXT_PUBLIC_MODO_DEMO=true

# ── Supabase: banco, login do painel /admin e fotos (Fase 1.5) ───────────────────────────
# Sem estas variáveis o site lê os imóveis de src/data (gerados de dados/imoveis.csv) e o painel
# fica desativado. Passo a passo em docs/MANUAL_ADMIN.md.
# Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Chave SECRETA: só no servidor (Vercel → Environment Variables). Nunca em código ou chat.
SUPABASE_SECRET_KEY=sb_secret_...
# Só para rodar as migrações do seu computador (npm run supabase:migrar). Não vai para a Vercel.
# Connect → Connection string → Session pooler, com a senha do banco.
SUPABASE_DB_URL=postgresql://postgres.SEU-PROJETO:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Webhook que recebe os leads em JSON (n8n, Make, Google Apps Script, CRM...).
# Com o Supabase configurado, os leads ficam no painel e o webhook é uma cópia extra (opcional).
# Sem banco e sem webhook, os leads são registrados no log do servidor (dados mascarados).
LEADS_WEBHOOK_URL=
# Opcional: enviado como "Authorization: Bearer <token>" para o webhook.
LEADS_WEBHOOK_TOKEN=

# Analytics desativado até haver provedor configurado (e consentimento, se não essencial).
NEXT_PUBLIC_ANALYTICS_ATIVO=false

# Opcional: máximo de envios de formulário por IP a cada 10 minutos (padrão 5).
# LIMITE_LEADS_MAX=5
